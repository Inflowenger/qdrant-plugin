# Platform identity — minted by Infra when the plugin is defined in a space.
# Copy to .env.inflow and fill in. NO Qdrant configuration lives here: the Qdrant
# URL and API key are entered per-account in the node's settings dialog and arrive
# with every call as body.settings.

PLUGIN_ID=aa-bbb-ccc-dddd
INFRA_CRED=base64-of-the-nats-.creds-blob
INFRA_URL=localhost:4222

# Optional: raise the NATS request/reply deadline (seconds) if Qdrant is slow.
# REQ_TIMEOUT=30
